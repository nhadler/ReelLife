# Nightly snapshot and housekeeping; started by
# reeltime-snapshot.timer. Runs as the same dynamic user as the web
# service so it can read and write the same state directory.
[Unit]
Description=ReelTime nightly snapshot and housekeeping
Documentation=file:///opt/reeltime/deploy/README.md

[Service]
Type=oneshot
User=reeltime
DynamicUser=yes
StateDirectory=reeltime
StateDirectoryMode=0700
WorkingDirectory=/opt/reeltime
EnvironmentFile=/etc/reeltime/reeltime.env
Environment=DJANGO_SETTINGS_MODULE=reeltime.settings.prod
Environment=REELTIME_DATA_DIR=%S/reeltime
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
LoadCredential=secret_key:/etc/reeltime/secret_key
LoadCredential=oidc_client_secret:/etc/reeltime/oidc_client_secret
Environment=REELTIME_SECRET_KEY_FILE=%d/secret_key
Environment=OIDC_CLIENT_SECRET_FILE=%d/oidc_client_secret
ExecStart=/opt/reeltime/.venv/bin/reeltime nightly

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
