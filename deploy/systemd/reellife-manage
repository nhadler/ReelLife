#!/bin/sh
# Runs a `reellife` management command the way the service runs: as its
# dynamic user, with its state directory, settings and secrets. Running
# commands as root instead could leave root-owned database files behind.
#   sudo /opt/reellife/deploy/systemd/reellife-manage create_breakglass
set -eu

UNIT="reellife-manage-$$"
CREDENTIALS="/run/credentials/$UNIT.service"

exec systemd-run --quiet --wait --pipe --collect --unit="$UNIT" \
  --property=User=reellife \
  --property=DynamicUser=yes \
  --property=StateDirectory=reellife \
  --property=StateDirectoryMode=0700 \
  --property=WorkingDirectory=/opt/reellife \
  --property=UMask=0077 \
  --property=EnvironmentFile=/etc/reellife/reellife.env \
  --property=Environment=DJANGO_SETTINGS_MODULE=reellife.settings.prod \
  --property=Environment=REELLIFE_DATA_DIR=/var/lib/reellife \
  --property=Environment=PYTHONDONTWRITEBYTECODE=1 \
  --property=LoadCredential=secret_key:/etc/reellife/secret_key \
  --property=LoadCredential=oidc_client_secret:/etc/reellife/oidc_client_secret \
  --property=Environment=REELLIFE_SECRET_KEY_FILE="$CREDENTIALS/secret_key" \
  --property=Environment=OIDC_CLIENT_SECRET_FILE="$CREDENTIALS/oidc_client_secret" \
  /opt/reellife/.venv/bin/reellife "$@"
