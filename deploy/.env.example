# ReelLife configuration. Copy to .env and fill in.
# Any variable can come from a file instead: set NAME_FILE=/path.

# The image to run. Pin a release (ghcr.io/nhadler/reellife:1.3.0) so
# upgrades happen when you choose; "latest" follows every release.
REELLIFE_IMAGE=ghcr.io/nhadler/reellife:latest

# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(50))'
REELLIFE_SECRET_KEY=

# The name people use to reach ReelLife, and its https origin.
REELLIFE_ALLOWED_HOSTS=reellife.tail1234.ts.net
REELLIFE_BASE_URL=https://reellife.tail1234.ts.net

# The time zone dates and times are shown in (IANA name).
REELLIFE_TIME_ZONE=America/Los_Angeles

# true only when a proxy in front terminates TLS and sets
# X-Forwarded-Proto and X-Forwarded-For (Caddy, Traefik, Tailscale Serve).
REELLIFE_TRUST_PROXY=true

# PocketID: the issuer URL and a confidential client whose redirect URI
# is REELLIFE_BASE_URL + /auth/oidc/callback/
OIDC_ISSUER=https://id.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# PocketID groups that grant each role.
OIDC_GROUP_ADMIN=reellife-admins
OIDC_GROUP_EDITOR=reellife-editors
OIDC_GROUP_VIEWER=reellife-viewers

# Emergency local admin; leave false unless PocketID is down.
REELLIFE_BREAKGLASS_ENABLED=false

# Gunicorn worker processes.
REELLIFE_WORKERS=2

# Where Help's Source Code link goes. Leave it unless you run a modified
# copy for others: the AGPL then asks you to offer them your source.
# REELLIFE_SOURCE_URL=https://github.com/nhadler/reellife

# Once a day the scheduler asks GitHub for the latest release, so admins
# see when an update is out. false turns this off; nothing is sent but
# the request itself.
# REELLIFE_UPDATE_CHECK=true
