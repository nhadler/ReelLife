# Adapted from Google's pylintrc (https://google.github.io/styleguide/pylintrc)
# for 4-space indents and 80 columns. Checks that ruff already enforces
# (imports, docstrings, line length) are disabled here to avoid noise.

[MAIN]
jobs = 0
ignore = migrations
load-plugins = pylint_django
django-settings-module = reeltime.settings.test
py-version = 3.12

[MESSAGES CONTROL]
disable =
    duplicate-code,
    fixme,
    line-too-long,
    missing-class-docstring,
    missing-function-docstring,
    missing-module-docstring,
    too-few-public-methods,
    # Django models and admin classes inherit deep framework hierarchies.
    too-many-ancestors,
    too-many-arguments,
    too-many-positional-arguments,
    ungrouped-imports,
    wrong-import-order,

[BASIC]
good-names = i, j, k, f, h, m, s, ex, _
# Test names describe the behaviour, so they run long.
function-rgx = ^(?:(?P<test>test_[a-z0-9_]+)|[a-z_][a-z0-9_]{0,40})$
method-rgx = ^(?:(?P<test>test_[a-z0-9_]+)|[a-z_][a-z0-9_]{0,40})$

[FORMAT]
max-line-length = 80
indent-string = "    "

[DESIGN]
# Frozen dataclasses carry records (an import row, a preview change).
max-attributes = 12
max-locals = 20
max-branches = 15
max-returns = 8
